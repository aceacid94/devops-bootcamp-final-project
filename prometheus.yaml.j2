global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'node_exporter'
    static_configs:
      - targets: ['{{ hostvars[groups["web"][0]]["ansible_host"] | default(hostvars[groups["web"][0]]["ansible_default_ipv4"]["address"]) }}:9100']
